{
  "manifest_version": 3,
  "name": "AI Guard",
  "version": "0.1.0",
  "description": "On-device phishing and scam protection. Nothing leaves your browser.",
  "icons": { "16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "AI Guard",
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "webNavigation", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}